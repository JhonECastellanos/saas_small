# --- Desarrollo local (SQLite) ---
# Deja DATABASE_URL sin definir para usar sqlite:///./dev.db automáticamente.

# --- Producción (Supabase) ---
# URL del POOLER transaction-mode (puerto 6543) — la usa la API en Vercel:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# URL DIRECTA (puerto 5432) — solo para migraciones/seed desde tu máquina:
# DIRECT_DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require

# Secreto para firmar JWT (genera uno: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_MINUTES=480

# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

ENV=development
